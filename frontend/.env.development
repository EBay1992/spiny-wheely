# Default (`npm run dev`): leave empty — Vite proxies API → localhost:3000
# VITE_API_URL=

# With `npm run scale:up`, use `npm run scale:web` (points at localhost:8080)
# Or set manually:
# VITE_USE_REMOTE_API=true
# VITE_API_URL=http://localhost:8080

# Remote Fly API while running Vite:
# VITE_USE_REMOTE_API=true
# VITE_API_URL=https://spinywheely.fly.dev
