# ── Local dev (`npm run dev`) ─────────────────────────────────────────────
# Leave VITE_API_URL empty — Vite proxies API + WebSocket to localhost:3000.
# VITE_API_URL=

# Optional: hit the live Fly API while running Vite locally
# VITE_USE_REMOTE_API=true
# VITE_API_URL=https://spinywheely.fly.dev

# ── Production (Fly) ────────────────────────────────────────────────────────
# Leave VITE_API_URL unset — nginx serves UI and proxies API on the same host.
