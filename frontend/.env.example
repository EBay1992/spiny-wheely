# ── Local dev (`npm run dev`) ─────────────────────────────────────────────
# Leave VITE_API_URL empty — Vite proxies API + WebSocket to localhost:3000.
# VITE_API_URL=

# To hit a remote API while running Vite locally (optional):
# VITE_USE_REMOTE_API=true
# VITE_API_URL=https://spinywheely-api.onrender.com

# ── Production (Vercel) ───────────────────────────────────────────────────
# Set in Vercel dashboard → Environment Variables (not in git):
# VITE_API_URL=https://spinywheely-api.onrender.com

# ── Production (Fly / nginx same-origin) ────────────────────────────────────
# Leave VITE_API_URL unset — UI and API share one host.
