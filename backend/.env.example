NODE_ENV=development
PORT=3000

# Local Docker Compose (or set DATABASE_URL for managed Postgres)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=spinywheely
DATABASE_PASSWORD=spinywheely
DATABASE_NAME=spinywheely
# DATABASE_URL=postgresql://user:pass@host:5432/spinywheely

# Redis — local Docker Compose:
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis — managed / TLS (takes precedence over REDIS_HOST):
# REDIS_URL=rediss://user:pass@host:6379

# Per-replica Postgres pool size (tune: replicas × pool ≤ DB max_connections)
DATABASE_POOL_MAX=10

# Set in K8s via downward API (pod name) for log correlation
# INSTANCE_ID=api-pod-abc123

JWT_SECRET=change-me-in-production

# Optional — lock CORS to your frontend origins (comma-separated).
# Unset = allow any origin (fine for demos; set in production).
# CORS_ORIGINS=http://localhost:5173,https://spinywheely.fly.dev
