NODE_ENV=development
PORT=3000

# Local Docker Compose (or set DATABASE_URL for managed Postgres e.g. Render)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=spinywheely
DATABASE_PASSWORD=spinywheely
DATABASE_NAME=spinywheely
# DATABASE_URL=postgresql://user:pass@host:5432/spinywheely

# Omit REDIS_HOST to run without Redis (single-instance deploys). Local dev:
# Omit REDIS_HOST to run without Redis (single-instance deploys, e.g. Render free tier)
REDIS_HOST=localhost
REDIS_PORT=6379

# Per-replica Postgres pool size (tune: replicas × pool ≤ DB max_connections)
DATABASE_POOL_MAX=10

# Set in K8s via downward API (pod name) for log correlation
# INSTANCE_ID=api-pod-abc123

JWT_SECRET=change-me-in-production
